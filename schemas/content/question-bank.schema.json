{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mentorbit.invalid/spec/0.1/content/question-bank.schema.json",
  "title": "题库（question-bank）",
  "description": "选项引用、variantOf 无环与节点引用可解析由校验工具检查。",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "license", "attribution", "questions"],
  "properties": {
    "$schema": { "type": "string" },
    "format": { "const": "mentorbit.question-bank/0.1" },
    "license": { "type": "string", "minLength": 1 },
    "attribution": { "type": "string", "minLength": 1, "maxLength": 1000 },
    "questions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "items": { "$ref": "#/$defs/question" }
    }
  },
  "$defs": {
    "entryId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$" },
    "ref": {
      "type": "string",
      "pattern": "^([a-z][a-z0-9-]{1,38}\\.[a-z][a-z0-9-]{1,38}/)?[a-z][a-z0-9_]{1,31}#[a-z0-9][a-z0-9_-]{0,63}$"
    },
    "markdown": { "type": "string", "minLength": 1, "maxLength": 20000 },
    "option": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "text"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]{1,8}$" },
        "text": { "$ref": "#/$defs/markdown" }
      }
    },
    "question": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "stem", "answer", "explanation", "nodes", "difficulty"],
      "properties": {
        "id": { "$ref": "#/$defs/entryId" },
        "type": { "enum": ["single_choice", "multiple_choice", "true_false", "short_answer"] },
        "stem": { "$ref": "#/$defs/markdown" },
        "options": { "type": "array", "minItems": 2, "maxItems": 10, "items": { "$ref": "#/$defs/option" } },
        "answer": {
          "oneOf": [
            {
              "type": "object", "additionalProperties": false, "required": ["optionIds"],
              "properties": { "optionIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } } }
            },
            {
              "type": "object", "additionalProperties": false, "required": ["value"],
              "properties": { "value": { "type": "boolean" } }
            },
            {
              "type": "object", "additionalProperties": false, "required": ["reference"],
              "properties": {
                "reference": { "$ref": "#/$defs/markdown" },
                "rubric": { "type": "array", "maxItems": 10, "items": { "type": "string", "minLength": 1, "maxLength": 500 } }
              }
            }
          ]
        },
        "explanation": { "$ref": "#/$defs/markdown" },
        "hints": { "type": "array", "maxItems": 5, "items": { "$ref": "#/$defs/markdown" } },
        "nodes": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/ref" } },
        "difficulty": { "type": "integer", "minimum": 1, "maximum": 5 },
        "variantOf": { "$ref": "#/$defs/entryId" }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "enum": ["single_choice", "multiple_choice"] } } },
          "then": { "required": ["options"], "properties": { "answer": { "required": ["optionIds"] } } }
        },
        {
          "if": { "properties": { "type": { "const": "single_choice" } } },
          "then": { "properties": { "answer": { "properties": { "optionIds": { "maxItems": 1 } } } } }
        },
        {
          "if": { "properties": { "type": { "const": "true_false" } } },
          "then": { "not": { "required": ["options"] }, "properties": { "answer": { "required": ["value"] } } }
        },
        {
          "if": { "properties": { "type": { "const": "short_answer" } } },
          "then": { "not": { "required": ["options"] }, "properties": { "answer": { "required": ["reference"] } } }
        }
      ]
    }
  }
}
