{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mentorbit.invalid/spec/0.1/content/lecture-set.schema.json",
  "title": "讲义（lecture-set）",
  "description": "讲义文件存在性、受限 Markdown 规则与节点引用可解析由校验工具检查。",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "license", "attribution", "lectures"],
  "properties": {
    "$schema": { "type": "string" },
    "format": { "const": "mentorbit.lecture-set/0.1" },
    "license": { "type": "string", "minLength": 1 },
    "attribution": { "type": "string", "minLength": 1, "maxLength": 1000 },
    "lectures": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "path", "nodes"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$" },
          "title": {
            "oneOf": [
              { "type": "string", "minLength": 1 },
              { "type": "object", "minProperties": 1, "additionalProperties": { "type": "string", "minLength": 1 } }
            ]
          },
          "path": {
            "type": "string",
            "pattern": "^(?!/)(?!.*\\\\)(?!.*:)(?!.*(^|/)\\.\\.(/|$))[^\\u0000]+\\.md$"
          },
          "nodes": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^([a-z][a-z0-9-]{1,38}\\.[a-z][a-z0-9-]{1,38}/)?[a-z][a-z0-9_]{1,31}#[a-z0-9][a-z0-9_-]{0,63}$"
            }
          },
          "estimatedMinutes": { "type": "integer", "minimum": 1, "maximum": 600 }
        }
      }
    }
  }
}
